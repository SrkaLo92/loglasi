APP_NAME=loglasi.rs
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=sr
APP_FALLBACK_LOCALE=sr
APP_FAKER_LOCALE=sr_Latn_RS

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=loglasi
DB_USERNAME=loglasi
DB_PASSWORD=loglasi

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail: Hostinger SMTP in production (smtp.hostinger.com, SSL on 465). Locally keep "log".
# The password is the mailbox password from hPanel; never commit it.
MAIL_MAILER=log
MAIL_SCHEME=smtps
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=noreply@loglasi.rs
MAIL_PASSWORD=
MAIL_EHLO_DOMAIN=loglasi.rs
MAIL_FROM_ADDRESS="noreply@loglasi.rs"
MAIL_FROM_NAME="loglasi.rs"

# Push notifications (FCM HTTP v1). Path to the Firebase service-account JSON, outside public/.
# Empty = push is off (logged at debug level). FCM_PROJECT_ID defaults to project_id from the JSON.
FCM_CREDENTIALS=
FCM_PROJECT_ID=

# Before the launch: NOTIFICATIONS_HOLD=true sends mail only to NOTIFICATIONS_ALLOW (emails or @domains, comma separated) and no push.
NOTIFICATIONS_HOLD=false
NOTIFICATIONS_ALLOW=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Uvoz iz WordPress-a (php artisan uvoz:wordpress), vidi docs/moduli/uvoz.md
WP_DB_HOST=127.0.0.1
WP_DB_PORT=3306
WP_DB_SOCKET=
WP_DB_DATABASE=local
WP_DB_USERNAME=root
WP_DB_PASSWORD=root
WP_DB_PREFIX=wp_
